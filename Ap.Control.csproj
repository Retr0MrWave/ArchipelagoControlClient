<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- The RIDs live here rather than on the CI command line on purpose. A self-contained publish
         infers a RID even when none is given, and a RID-specific restore REWRITES packages.lock.json
         to add a "net10.0/win-x64" target. A later restore in locked mode that evaluates without a
         RID then sees a lock file it disagrees with and fails NU1004. Making it a project property
         means every restore, build and publish (local, CI, Debug, Release) evaluates the same set,
         so the lock file stays valid.

         RuntimeIdentifiers (plural) is that set, and is deliberately host-independent: restoring on
         Windows and on macOS has to compute the same lock-file targets. RuntimeIdentifier (singular)
         only picks which member this build produces - SelfContained needs exactly one - and defaults
         to the host's, so `dotnet build` does the obvious thing on either machine. -->
    <RuntimeIdentifiers>win-x64;osx-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- Players should not have to install the .NET runtime to run the client. -->
    <SelfContained>true</SelfContained>

    <!-- Publish as ONE file. IncludeNativeLibrariesForSelfExtract matters here: without it a
         self-contained single-file build still drops its native runtime DLLs (coreclr, hostfxr, the
         System.*.Native set) beside the exe, so the output is a folder again rather than one file.
         Compression roughly halves the result, at the cost of a slightly slower first start.

         UNCONDITIONAL for the same reason as RuntimeIdentifier above: a self-contained single-file
         build pulls in an implicit Microsoft.NET.ILLink.Tasks reference, so making these Release-only
         changes the restore graph between Debug and Release and breaks locked-mode restore (NU1004).
         They only take effect at publish time, so applying them in Debug costs nothing. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keeps the drop to just the .exe instead of shedding a .pdb beside it. Safe to leave
         Release-only: DebugType does not affect the restore graph. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Ap.Control.Patcher\**" />
    <Compile Remove="native\**" />
    <EmbeddedResource Remove="Ap.Control.Patcher\**" />
    <EmbeddedResource Remove="native\**" />
    <None Remove="Ap.Control.Patcher\**" />
    <None Remove="native\**" />
  </ItemGroup>

  <!-- The macOS client carries the helper dylib and its launch wrapper, so `install-launcher` can
       write them out itself. That is not only convenience: a file the client writes is not
       quarantined, whereas the same two files extracted from a downloaded archive may be - and a
       quarantined dylib is refused inside a hardened-runtime process.

       Conditional on the dylib existing so a checkout that has not run `make -C native/apshim`
       still builds. When it is missing, `install-launcher` says so and points at the Makefile
       rather than writing a truncated file. Items do not affect the restore graph, so unlike the
       properties above these conditions are safe. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <EmbeddedResource Include="native\apshim\out\libapcontrol.dylib"
                      LogicalName="libapcontrol.dylib"
                      Condition="Exists('native\apshim\out\libapcontrol.dylib')" />
    <EmbeddedResource Include="native\apshim\apcontrol-launch.sh"
                      LogicalName="apcontrol-launch.sh" />
  </ItemGroup>

  <ItemGroup>
    <!-- The item map is read from AppContext.BaseDirectory at startup, so it has to reach the build
         output dir. PreserveNewest rather than Always so a map edited in place next to the exe isn't
         clobbered by a rebuild.

         CopyToPublishDirectory="Never" keeps it OUT of the published drop: publish ships one exe, and
         the map comes from the embedded copy below. A player who wants to edit the table can still
         drop an apitems.json next to the exe (or pass the items option) and it takes precedence. -->
    <None Update="apitems.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />

    <!-- LogicalName pins the resource name so the lookup in Program.cs cannot break on a namespace
         change. -->
    <EmbeddedResource Include="apitems.json" LogicalName="apitems.json" />

    <EmbeddedResource Include="ui\*.js" LogicalName="ui/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
    <PackageReference Include="Archipelago.MultiClient.Net.Analyzers" Version="2.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
